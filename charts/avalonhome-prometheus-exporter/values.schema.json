{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AvalonHome Prometheus Exporter chart values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replicaCount",
    "image",
    "serviceAccount",
    "podSecurityContext",
    "containerSecurityContext",
    "config",
    "service",
    "resources",
    "networkPolicy",
    "serviceMonitor"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "latest"
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object",
      "propertyNames": {
        "not": {
          "enum": ["app.kubernetes.io/name", "app.kubernetes.io/instance"]
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "automountServiceAccountToken", "annotations", "labels", "name"],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "propertyNames": {
        "not": {
          "enum": ["app.kubernetes.io/name", "app.kubernetes.io/instance"]
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "avalonIP",
        "avalonIPs",
        "avalonPort",
        "updateInterval",
        "exporterPort",
        "exportChipMetrics",
        "minerTimeout",
        "enableDebugEndpoint",
        "logLevel"
      ],
      "oneOf": [
        {
          "properties": {
            "avalonIP": {
              "minLength": 1
            },
            "avalonIPs": {
              "maxItems": 0
            }
          }
        },
        {
          "properties": {
            "avalonIP": {
              "const": ""
            },
            "avalonIPs": {
              "minItems": 1
            }
          }
        }
      ],
      "properties": {
        "avalonIP": {
          "$ref": "#/$defs/host"
        },
        "avalonIPs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/host"
          }
        },
        "avalonPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "updateInterval": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "exporterPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "exportChipMetrics": {
          "type": "boolean"
        },
        "minerTimeout": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "enableDebugEndpoint": {
          "type": "boolean"
        },
        "logLevel": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"]
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port", "annotations", "labels"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": ["app.kubernetes.io/name", "app.kubernetes.io/instance"]
            }
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "required": ["cpu", "memory"]
        },
        "limits": {
          "type": "object",
          "required": ["cpu", "memory"]
        }
      }
    },
    "livenessProbe": {
      "$ref": "#/$defs/probe"
    },
    "readinessProbe": {
      "$ref": "#/$defs/probe"
    },
    "startupProbe": {
      "$ref": "#/$defs/probe"
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "strategy": {
      "type": "object"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "priorityClassName": {
      "type": "string"
    },
    "runtimeClassName": {
      "type": "string"
    },
    "dnsPolicy": {
      "type": "string",
      "enum": ["ClusterFirst", "Default", "None"]
    },
    "dnsConfig": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array"
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "value": {
            "type": ["string", "number", "boolean"]
          },
          "valueFrom": {
            "type": "object"
          }
        },
        "oneOf": [
          {
            "required": ["value"]
          },
          {
            "required": ["valueFrom"]
          }
        ]
      }
    },
    "extraEnvFrom": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraContainers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "initContainers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": ["integer", "string", "null"]
        },
        "maxUnavailable": {
          "type": ["integer", "string", "null"]
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingress", "additionalIngress", "egress", "policyTypes"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowExternal", "from"],
          "properties": {
            "allowExternal": {
              "type": "boolean"
            },
            "from": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "additionalIngress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "egress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "policyTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["Ingress", "Egress"]
          }
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "namespace",
        "annotations",
        "labels",
        "interval",
        "scrapeTimeout",
        "path",
        "scheme",
        "honorLabels",
        "relabelings",
        "metricRelabelings",
        "tlsConfig"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "interval": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
        },
        "scrapeTimeout": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
        },
        "path": {
          "type": "string",
          "pattern": "^/[^?#]*$"
        },
        "scheme": {
          "type": "string",
          "enum": ["http", "https"]
        },
        "honorLabels": {
          "type": "boolean"
        },
        "relabelings": {
          "type": "array"
        },
        "metricRelabelings": {
          "type": "array"
        },
        "tlsConfig": {
          "type": "object"
        }
      }
    },
    "test": {
      "type": "object",
      "required": ["image", "securityContext"],
      "properties": {
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"]
        },
        "securityContext": {
          "type": "object"
        }
      }
    }
  },
  "$defs": {
    "host": {
      "type": "string",
      "pattern": "^$|^\\[[0-9A-Fa-f:.]+\\]$|^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$"
    },
    "probe": {
      "type": "object",
      "required": [
        "enabled",
        "httpGet",
        "initialDelaySeconds",
        "periodSeconds",
        "timeoutSeconds",
        "failureThreshold",
        "successThreshold"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "httpGet": {
          "type": "object",
          "required": ["path", "port"]
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
